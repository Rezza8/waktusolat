<?xml version="1.0" encoding="utf-8"?>
<!-- Neutral highlight for the next azan column. RemoteViews cannot tint a
     drawable per theme, so the colour accent is carried by the text instead. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#2EFFFFFF" />
    <corners android:radius="8dp" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
